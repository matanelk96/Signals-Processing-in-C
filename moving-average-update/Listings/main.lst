   1          /*
   2          Name: Matan Ronen & Matanel Kadosh
   3          Date: 14.07.2026
   4          Grader: ?
   5          File: main.c
   6          This file implement an IIR moving average filter on the data 
   7          from channel 0 ADC. In DAC0 the output is the origin data,
   8          and in DAC1 the output is the data after the filter.
   9          */
  10          #include <aduc841.h>
  11          #include <stdio.h>
  12          #include "peripherals.h"
  13          
  14          #define FILTER_LENGTH 50
  15          
  16          long int sum = 0;
  17          unsigned int filtered = 0;
  18          unsigned int oldest;
  19          
  20          void main(void)
  21          {
  22   1        T2_Init();               // Initialize Timer 2 for ADC sampling rate
  23   1          ADC_Init();              // Initialize Analog-to-Digital Converter
  24   1          DAC_Init();              // Initialize Digital-to-Analog Converters
  25   1          GlobalINT();             // Enable global interrupts
  26   1          cbuffer_reset(&cbuffer); // Clear all values in the circular buffer
  27   1        
  28   1          while (1)
  29   1          {
  30   2              if (ADCflag) // Check if a new sample is ready
  31   2              {
  32   3                  ADCflag = 0;  // Clear the flag for the next interrupt
  33   3                  oldest = update_cbuffer(&cbuffer, newsample);  // Add the new sample to the buffer and retriev
             -e the oldest sample
  34   3                  sum = (sum - oldest) + newsample;  // Update the running sum (subtract oldest, add newest)
  35   3                  filtered = sum / FILTER_LENGTH;    // Calculate the moving average
  36   3                  DAC0DATA =  newsample;    // Output the raw signal to DAC0
  37   3                  DAC1DATA = filtered;      // Output the filtered signal to DAC1
  38   3              }
  39   2          }
  40   1      }


