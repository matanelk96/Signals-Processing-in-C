line level    source

   1          /*
   2          Names: Matan Ronen & Matanel Kadosh
   3          File: peripherals.c
   4          ADC interrupt service routine implementing the FIR low-pass filter
   5          (Chapter 22). Samples channel 0 of the ADC, outputs the raw sample to
   6          DAC0, runs the filter (shift buffer + convolution with the coefficients
   7          from coeffs.h), clamps a negative result to zero, and outputs the
   8          filtered result to DAC1.
   9          */
  10          
  11          #include <aduc841.h>
  12          #include "peripherals.h"
  13          #include "coeffs.h"          // N, NUM_COEFF, SCALE_FACTOR and the code array h[]
  14          
  15          int idata buffer[NUM_COEFF]; // oldest sample at index 0, newest at NUM_COEFF-1
  16          
  17          void ADC_ISR(void) interrupt 6
  18          {
  19   1          unsigned char i;
  20   1          long int sum = 0;
  21   1          int new_sample = ADCDATA & 0x0FFF;     // only the lower 12 bits carry the sample
  22   1      
  23   1          ADCI = 0;
  24   1          DAC0 = new_sample;                     // raw, unfiltered sample
  25   1      
  26   1          for (i = 0; i < NUM_COEFF - 1; i++)    // shift the buffer left
  27   1          {
  28   2              buffer[i] = buffer[i + 1];
  29   2          }
  30   1          buffer[NUM_COEFF - 1] = new_sample;    // newest sample at the highest index
  31   1      
  32   1          for (i = 0; i < NUM_COEFF; i++)        // convolution sum
  33   1          {
  34   2              sum += (long int)h[i] * (long int)buffer[i];
  35   2          }
  36   1          sum /= SCALE_FACTOR;                   // undo the coefficient scaling
  37   1      
  38   1          if (sum < 0)
  39   1              sum = 0;                           // clamp negative output to zero
  40   1      
  41   1          DAC1 = (int)sum;                       // filtered output
  42   1      }


