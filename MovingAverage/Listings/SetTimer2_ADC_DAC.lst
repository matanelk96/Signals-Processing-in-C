   1          #include "aduc841.h"
   2          #include "SetTimer2_ADC_DAC.h"
   3          
   4          /*
   5           * Names: Matan Ronen & Matanel Kadosh
   6           * File: SetTimer2_ADC_DAC.c
   7           * Timer 2, ADC and DAC setup. Target: 5 kHz sampling.
   8           * Reload = 65536 - round(11059200 / 5000) = 0xF75C (actual 4999.6 Hz).
   9           */
  10          
  11          void init_Timer2(void)
  12          {
  13   1         T2CON = 0x00;   // Auto-reload, timer mode
  14   1         RCAP2H = 0xF7;  // Reload value, high byte
  15   1         RCAP2L = 0x5C;  // Reload value, low byte
  16   1         TH2 = RCAP2H;   // Initial load
  17   1         TL2 = RCAP2L;
  18   1         TF2 = 0;        // Clear overflow flag
  19   1         TR2 = 1;        // Start Timer 2
  20   1      }
  21          
  22          void setADC(void)
  23          {
  24   1         ADCCON1 = 0xBA;  // ADC on, Vref internal, Timer 2 starts conversions
  25   1         CCONV = 1;       // Continuous conversion
  26   1         ADCCON2 &= 0xF0; // Channel 0
  27   1         EADC = 1;        // Enable ADC interrupt
  28   1      }
  29          
  30          void setDAC(void)
  31          {
  32   1         DACCON = 0x1B;   // 12-bit, range VREF, sync bit cleared
  33   1      }


