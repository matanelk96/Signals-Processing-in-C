  24   2            {
  25   3                // Prepare the string and reset the array index 'i' to 0
  26   3                print_measured(); 
  27   3      
  28   3                // Temporarily disable UART interrupts to prevent disruption
  29   3                // from incoming characters (like pressing 'm' again) during transmission
  30   3                ES = 0; 
  31   3                
  32   3                // Transmit the entire string sequentially until the Null terminator ('\0')
  33   3                while (header[i] != '\0')
  34   3                {
  35   4                    SBUF = header[i];
  36   4                    while(TI == 0);  // Wait for the hardware to finish transmitting the current character
  37   4                    TI = 0;          // Manually clear the transmit interrupt flag
  38   4                    i++;             // Move to the next character in the array
  39   4                }
  40   3                
  41   3                ES = 1;   // Re-enable UART interrupts for future receptions
  42   3                FLAG = 0; // Transmission complete, reset the FLAG
  43   3            }
  44   2            
  45   2            if(ADCI)
  46   2            {
  47   3                ADCI = 0; // Clear the ADC interrupt flag
  48   3                
  49   3                // Read the 12-bit ADC value from the data registers
  50   3                voltage = (ADCDATAH << 8) | ADCDATAL;
  51   3                voltage &= 0x0FFF; // Mask the upper 4 bits to ensure a valid 12-bit value
  52   3                
  53   3                is_voltage = calculate_voltage(); // Calculate volt_h and volt_l
