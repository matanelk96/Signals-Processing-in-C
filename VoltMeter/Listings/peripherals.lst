  61          void print_measured( void )
  62          {
  63   1          i = 0; // Reset the string index back to the beginning
  64   1          
  65   1          // Format the measured voltage into the 'header' buffer.
  66   1          // Note: We removed the 'if (is_voltage)' condition because the ADC 
  67   1          // continuously updates volt_h and volt_l in the background, 
  68   1          // so we just print their most recent values whenever requested.
  69   1          sprintf(header, "The measured voltage is %d.%03d. \n\r", volt_h, volt_l);
  70   1      }
  71          
  72          
  73          int calculate_voltage( void )
  74          {
  75   1         
  76   1         //Storing the voltage (in millivolt) value in in 2 diffrent variables for the sprintf
  77   1         voltage *= 61035;
  78   1         volt_h = voltage / 100000000;
  79   1         volt_l = (voltage % 100000000) / 100000;
